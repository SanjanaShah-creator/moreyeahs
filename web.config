<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <!-- Allow up to 50 MB — needed for base64-encoded resume uploads -->
                <requestLimits maxAllowedContentLength="52428800" />
            </requestFiltering>
        </security>
        <rewrite>
            <rules>
                <rule name="ReverseProxyInboundRule1" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:3003/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
